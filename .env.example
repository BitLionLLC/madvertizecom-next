# SMTP credentials for the contact form. Copy to .env and fill in.
#
# madvertize.com runs on Google Workspace (its MX record is smtp.google.com),
# so the host below is already correct. The password must be a Google App
# Password from https://myaccount.google.com/apppasswords — Google rejects the
# normal account password over SMTP. App Passwords need 2-Step Verification on
# the account first.
#
# If the mailbox ever moves off Google, take the host from the new provider's
# own documentation; a guessed name like mail.<domain> usually does not resolve.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=miru@madvertize.com
SMTP_PASSWORD=

# Optional. SMTP_SECURE defaults to true on port 465 and false otherwise.
# SMTP_SECURE=false

# Optional. Defaults to SMTP_USER; most hosts only allow sending as the
# authenticated mailbox.
# SMTP_FROM=miru@madvertize.com

# Optional. Where enquiries are delivered; defaults to miru@madvertize.com.
# ENQUIRY_TO=miru@madvertize.com

# Google reCAPTCHA v3 keys from https://www.google.com/recaptcha/admin
# The site key is inlined into the browser bundle at build time, so it must be
# set before `npm run build`. With both keys unset the form still works, but
# submissions are only protected by the honeypot.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional. Lowest score (0-1) still treated as human; defaults to 0.5.
# RECAPTCHA_MIN_SCORE=0.5
